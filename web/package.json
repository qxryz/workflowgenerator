{
    "name": "workflowgenerator",
    "version": "0.14.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 3000",
        "build": "vite build",
        "desktop:dev": "bunx --no-install tauri dev",
        "desktop:build": "bunx --no-install tauri build --bundles app",
        "typecheck": "tsc --noEmit",
        "test": "node --test --experimental-strip-types tests/*.test.*",
        "test:media-retention": "node --test --experimental-strip-types tests/media-retention-policy.test.mjs",
        "start": "vite preview --host 0.0.0.0 --port 3000",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "author-library:validate": "node scripts/validate-author-library.mjs public/author-library/catalog.json"
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.1",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@react-three/drei": "10.7.7",
        "@react-three/fiber": "9.6.1",
        "@react-three/postprocessing": "3.0.4",
        "@tanstack/react-query": "^5.100.9",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-updater": "^2.10.1",
        "@uiw/react-codemirror": "^4.25.9",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "antd": "^6.4.2",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "hugeicons-react": "^0.4.0",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "shadcn": "^4.7.0",
        "streamdown": "^2.5.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "three": "^0.185.1",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@tauri-apps/cli": "^2.11.4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@vitejs/plugin-react": "^5.2.0",
        "prettier": "^3.8.3",
        "typescript": "^5",
        "vite": "^7.3.0"
    }
}
