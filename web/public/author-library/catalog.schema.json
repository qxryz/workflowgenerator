{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://workflowgenerator.local/schemas/author-library-catalog-v1.json",
    "title": "WorkflowGenerator Author Library Catalog",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "updatedAt", "publisher", "items"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "updatedAt": { "type": "string" },
        "publisher": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "homepage": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
        },
        "items": {
            "type": "array",
            "maxItems": 5000,
            "items": { "$ref": "#/$defs/item" }
        }
    },
    "$defs": {
        "base": {
            "type": "object",
            "required": ["id", "kind", "version", "title", "contentUrl", "sha256"],
            "properties": {
                "id": { "type": "string", "pattern": "^author\\.[a-z0-9][a-z0-9._-]{1,126}$" },
                "kind": { "enum": ["skill", "prompt", "asset"] },
                "version": { "type": "string", "minLength": 1, "maxLength": 64 },
                "title": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "authorNote": { "type": "string", "maxLength": 2000 },
                "tags": { "type": "array", "maxItems": 24, "items": { "type": "string" }, "uniqueItems": true },
                "category": { "type": "string" },
                "coverUrl": { "type": "string" },
                "contentUrl": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                "bytes": { "type": "integer", "minimum": 1 },
                "updatedAt": { "type": "string" }
            }
        },
        "skill": {
            "allOf": [
                { "$ref": "#/$defs/base" },
                {
                    "properties": {
                        "kind": { "const": "skill" },
                        "capabilities": {
                            "type": "array",
                            "minItems": 1,
                            "items": { "enum": ["workflow", "writing", "image", "video", "audio", "terminal"] },
                            "uniqueItems": true
                        },
                        "license": { "type": "string" },
                        "homepage": { "type": "string" },
                        "zodiacOnly": { "type": "boolean" }
                    },
                    "required": ["capabilities"]
                }
            ]
        },
        "prompt": {
            "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "kind": { "const": "prompt" } } }]
        },
        "asset": {
            "allOf": [
                { "$ref": "#/$defs/base" },
                {
                    "properties": {
                        "kind": { "const": "asset" },
                        "assetKind": { "enum": ["text", "image", "video", "audio"] },
                        "mimeType": { "type": "string", "minLength": 1 },
                        "note": { "type": "string" }
                    },
                    "required": ["assetKind", "mimeType"]
                }
            ]
        },
        "item": {
            "oneOf": [{ "$ref": "#/$defs/skill" }, { "$ref": "#/$defs/prompt" }, { "$ref": "#/$defs/asset" }]
        }
    }
}
