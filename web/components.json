{
    "$schema": "https://ui.shadcn.com/schema.json",
    "style": "radix-nova",
    "rsc": true,
    "tsx": true,
    "tailwind": {
        "config": "",
        "css": "src/app/globals.css",
        "baseColor": "neutral",
        "cssVariables": true,
        "prefix": ""
    },
    "iconLibrary": "lucide",
    "rtl": false,
    "aliases": {
        "components": "@/components",
        "utils": "@/lib/utils",
        "ui": "@/components/ui",
        "lib": "@/lib",
        "hooks": "@/hooks"
    },
    "menuColor": "default",
    "menuAccent": "subtle",
    "registries": {
        "@reactbits-starter": {
            "url": "https://proxy.collectui.pro/api/r/reactbits/starter/{name}.json",
            "headers": {
                "Authorization": "Bearer ${REACTBITS_LICENSE_KEY}"
            }
        },
        "@reactbits-pro": {
            "url": "https://proxy.collectui.pro/api/r/reactbits/pro/{name}.json",
            "headers": {
                "Authorization": "Bearer ${REACTBITS_LICENSE_KEY}"
            }
        }
    }
}